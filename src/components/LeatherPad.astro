---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { ART, artUrl } from "../lib/art";

interface Props {
  title: string;
}

const { title } = Astro.props;

/** Brandon rejected leather_pad*. Texture is leather_panel.png only. */
const leatherTextureRel = ART.v3.leatherPanel;
const hasLeatherTexture = existsSync(join(process.cwd(), "public", leatherTextureRel));
const textureUrl = hasLeatherTexture ? artUrl(leatherTextureRel) : "";
---

<div class="room-stage">
  <div class="room-veil" aria-hidden="true"></div>
  <article
    class="leather-panel"
    aria-label={title}
    data-has-texture={hasLeatherTexture ? "true" : "false"}
    style={hasLeatherTexture ? `--leather-texture: url("${textureUrl}")` : undefined}
  >
    <div class="leather-inset">
      <slot />
    </div>
  </article>
</div>

<script>
  const DISMISS_MS = 920;

  const reduceMotion = () =>
    document.documentElement.dataset.reduceMotion === "true" ||
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>(".room-stage").forEach((stage) => {
    if (stage.dataset.dismissBound === "true") return;
    stage.dataset.dismissBound = "true";

    stage.querySelectorAll<HTMLAnchorElement>("[data-home-link]").forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }
        if (link.target === "_blank") return;
        if (reduceMotion()) return;
        if (stage.classList.contains("is-dismissing")) {
          event.preventDefault();
          return;
        }
        event.preventDefault();
        stage.classList.add("is-dismissing");
        window.setTimeout(() => {
          window.location.assign(link.href);
        }, DISMISS_MS);
      });
    });
  });
</script>
