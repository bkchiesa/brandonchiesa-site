---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { ART, artUrl } from "../lib/art";

interface Props {
  title: string;
}

const { title } = Astro.props;
const publicDir = join(process.cwd(), "public");

const flatRel = ART.v3.leatherPadFlat;
const panelRel = ART.v3.leatherPanel;
const veilRel = ART.v3.leatherPadVeil;

const hasFlat = existsSync(join(publicDir, flatRel));
const hasPanel = existsSync(join(publicDir, panelRel));
const hasVeil = existsSync(join(publicDir, veilRel));

/** Prefer Pixel flat texture panel. 3D leather_pad.png stays unwired. */
const textureRel = hasFlat ? flatRel : hasPanel ? panelRel : "";
const fill = hasFlat ? "flat" : hasPanel ? "panel" : "none";
const textureUrl = textureRel ? artUrl(textureRel) : "";
const veilUrl = hasVeil ? artUrl(veilRel) : "";
---

<div class="room-stage">
  <div class="room-dim" aria-hidden="true"></div>
  <div class="room-card">
    {
      hasVeil && (
        <div
          class="room-veil"
          aria-hidden="true"
          style={`--leather-veil: url("${veilUrl}")`}
        />
      )
    }
    <article
      class="leather-panel"
      aria-label={title}
      data-fill={fill}
      style={textureUrl ? `--leather-texture: url("${textureUrl}")` : undefined}
    >
      <div class="leather-inset">
        <slot />
      </div>
    </article>
  </div>
</div>
