---
import { VIDEO, artUrl } from "../lib/art";
---

<div class="video-shell" id="video-shell">
  <img
    class="video-poster"
    src={artUrl(VIDEO.loopPoster)}
    alt=""
    width="1280"
    height="720"
  />

  <video
    class="video-layer video-layer--loop"
    data-video="loop"
    poster={artUrl(VIDEO.loopPoster)}
    preload="auto"
    playsinline
    webkit-playsinline
    muted
    loop
    disablePictureInPicture
    disableRemotePlayback
  >
    <source src={artUrl(VIDEO.loop)} type="video/mp4" />
  </video>

  <button type="button" class="video-hit" data-video-hit hidden>
    <span class="video-hit-label" data-video-hit-label>Tap to play</span>
  </button>
</div>

<noscript>
  <style>
    .house-ui {
      opacity: 1 !important;
      visibility: visible !important;
      pointer-events: auto !important;
    }
    .video-shell video,
    .video-hit {
      display: none !important;
    }
  </style>
</noscript>

<script>
  const MOTION_KEY = "bc-reduce-motion";

  const loopVideo = document.querySelector<HTMLVideoElement>("[data-video='loop']");
  const hit = document.querySelector<HTMLButtonElement>("[data-video-hit]");
  const hitLabel = document.querySelector("[data-video-hit-label]");
  const reduceButtons = document.querySelectorAll("[data-reduce-motion]");

  const osReduce = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const userReduce = () => {
    try {
      return localStorage.getItem(MOTION_KEY) === "1";
    } catch {
      return false;
    }
  };
  const shouldReduce = () =>
    document.documentElement.dataset.reduceMotion === "true" ||
    userReduce() ||
    (localStorage.getItem(MOTION_KEY) !== "0" && osReduce());

  function prep(video: HTMLVideoElement | null) {
    if (!video) return;
    video.muted = true;
    video.defaultMuted = true;
    video.volume = 0;
    video.playsInline = true;
    video.setAttribute("playsinline", "");
    video.setAttribute("webkit-playsinline", "");
  }

  function showBanner() {
    document.documentElement.dataset.banner = "in";
  }

  function becomeHouse() {
    document.documentElement.dataset.shell = "ready";
    showBanner();
    document.dispatchEvent(new CustomEvent("bc:house-ready"));
  }

  function hideHit() {
    if (!hit) return;
    hit.hidden = true;
    hit.classList.remove("is-prompt");
    hit.removeAttribute("aria-label");
  }

  function showStartPrompt(label: string) {
    if (!hit || !hitLabel) return;
    hit.hidden = false;
    hit.classList.add("is-prompt");
    hit.setAttribute("aria-label", label);
    hitLabel.textContent = label;
  }

  async function playVideo(video: HTMLVideoElement) {
    prep(video);
    try {
      await video.play();
      return true;
    } catch {
      return false;
    }
  }

  let pendingLoop = false;

  async function startLoop() {
    if (!loopVideo || shouldReduce()) {
      loopVideo?.pause();
      loopVideo?.classList.remove("is-active");
      hideHit();
      becomeHouse();
      return;
    }
    prep(loopVideo);
    loopVideo.classList.add("is-active");
    const ok = await playVideo(loopVideo);
    hideHit();
    becomeHouse();
    if (!ok) {
      showStartPrompt("Tap to play");
      pendingLoop = true;
    } else {
      pendingLoop = false;
    }
  }

  function setReduce(on: boolean) {
    document.documentElement.dataset.reduceMotion = on ? "true" : "false";
    try {
      localStorage.setItem(MOTION_KEY, on ? "1" : "0");
    } catch {
      /* private mode */
    }
    reduceButtons.forEach((btn) => btn.setAttribute("aria-pressed", on ? "true" : "false"));
    if (on) {
      loopVideo?.pause();
      loopVideo?.classList.remove("is-active");
      hideHit();
      becomeHouse();
    } else {
      void startLoop();
    }
  }

  function syncReduceButtons() {
    const on = shouldReduce();
    reduceButtons.forEach((btn) => btn.setAttribute("aria-pressed", on ? "true" : "false"));
  }

  function onHit() {
    if (!pendingLoop || !loopVideo) return;
    pendingLoop = false;
    hideHit();
    void playVideo(loopVideo).then((ok) => {
      if (!ok) {
        showStartPrompt("Tap to play");
        pendingLoop = true;
      }
    });
  }

  function boot() {
    syncReduceButtons();
    prep(loopVideo);
    void startLoop();
  }

  hit?.addEventListener("click", onHit);

  reduceButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      setReduce(document.documentElement.dataset.reduceMotion !== "true");
    });
  });

  boot();
</script>
