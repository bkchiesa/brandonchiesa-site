---
import type { RoomId } from "../lib/site";

interface Props {
  id: RoomId;
}

const { id } = Astro.props;
---

<svg class="door-icon" viewBox="0 0 32 32" aria-hidden="true">
  {
    id === "career" && (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round">
        <rect x="5" y="12" width="22" height="14" rx="1.5" />
        <path d="M11 12 V10 a5 5 0 0 1 10 0 v2" />
        <path d="M5 17 H27" />
      </g>
    )
  }
  {
    id === "coding" && (
      <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
        <path d="M11 9 L6 16 L11 23" />
        <path d="M21 9 L26 16 L21 23" />
        <path d="M18 8 L14 24" />
      </g>
    )
  }
  {
    id === "videography" && (
      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <rect x="4" y="9" width="24" height="14" rx="2" />
        <circle cx="11" cy="16" r="2" />
        <circle cx="21" cy="16" r="2" />
        <path d="M4 12 H28 M4 20 H28" />
      </g>
    )
  }
</svg>
