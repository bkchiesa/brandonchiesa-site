---
import { ABOUT_PATH, SITE_DISCLAIMER, rooms, withBase } from "../lib/site";

interface Props {
  showDisclaimer?: boolean;
}

const { showDisclaimer = false } = Astro.props;
---

<footer class="site-footer">
  <nav aria-label="Site">
    <a class="mono" href={withBase()} data-home-link>Home</a>
    {
      rooms.map((room) => (
        <>
          <span aria-hidden="true"> · </span>
          <a href={withBase(room.path)}>{room.name}</a>
        </>
      ))
    }
    <span aria-hidden="true"> · </span>
    <a href={withBase(ABOUT_PATH)}>About</a>
  </nav>
  {
    showDisclaimer && (
      <p class="disclaimer" style="margin:0; border:0; padding:0;">
        {SITE_DISCLAIMER}
      </p>
    )
  }
</footer>
