---
import { BANK_DISCLAIMER, rooms, withBase } from "../lib/site";

interface Props {
  showDisclaimer?: boolean;
}

const { showDisclaimer = false } = Astro.props;
---

<footer class="site-footer">
  <nav aria-label="Rooms">
    <a class="mono" href={withBase()}>Menu</a>
    {
      rooms.map((room) => (
        <>
          <span aria-hidden="true"> · </span>
          <a href={withBase(room.path)}>{room.name}</a>
        </>
      ))
    }
  </nav>
  {
    showDisclaimer && (
      <p class="disclaimer" style="margin:0; border:0; padding:0;">
        {BANK_DISCLAIMER}
      </p>
    )
  }
</footer>
