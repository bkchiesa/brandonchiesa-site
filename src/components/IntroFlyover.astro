---
const durationMs = 10000;
---

<noscript>
  <style>
    #intro {
      display: none !important;
    }
  </style>
</noscript>
<div
  class="intro"
  id="intro"
  data-duration={durationMs}
  role="dialog"
  aria-modal="true"
  aria-labelledby="intro-title"
>
  <div class="intro-top">
    <p class="hud-kicker" id="intro-title">Intro — Tech meets Renaissance flyover</p>
    <button type="button" class="intro-skip mono" data-skip-intro>Skip intro</button>
  </div>

  <div class="intro-stage">
    <div class="intro-camera">
      <article class="scene" aria-label="1. Newport News Peninsula">
        <div class="scene-label">
          <span class="hud-kicker">1. Newport News Peninsula</span>
          <span class="hud-kicker">Coast · East →</span>
        </div>
        <div class="scene-art">
          <svg viewBox="0 0 640 420" role="img" aria-label="Placeholder plate of the Newport News Peninsula between the York and James Rivers">
            <title>Newport News Peninsula — placeholder</title>
            <rect class="water" x="20" y="20" width="600" height="380" fill-opacity="0.16" />
            <g class="hud" stroke-width="1.2">
              <circle cx="36" cy="36" r="8" />
              <path d="M36 28 V22 M36 44 V50 M28 36 H22 M44 36 H50" />
              <path d="M36 36 L48 48" />
            </g>
            <path
              class="land"
              d="M80 150
                C160 142 240 148 320 156
                C400 164 470 150 540 168
                C575 178 600 200 610 230
                C598 248 560 252 520 248
                C430 238 350 255 270 262
                C190 270 130 258 90 230
                C70 210 68 176 80 150 Z"
              fill-opacity="0.55"
              stroke-width="1.5"></path>
            <path class="water" d="M70 248 C160 268 260 278 360 268 C460 258 540 270 610 258" fill="none" stroke-width="3"></path>
            <path class="hud" d="M90 138 C180 128 280 136 380 128 C460 122 530 132 600 148" stroke-width="1.2" stroke-dasharray="3 4"></path>
            <text x="250" y="210" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="1.5" fill="currentColor">PENINSULA</text>
            <text x="430" y="300" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1.2" fill="currentColor">JAMES RIVER</text>
            <path class="hud" d="M500 220 H590" stroke-width="1" marker-end="url(#east)"></path>
            <defs>
              <marker id="east" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto">
                <path d="M0 1 L9 5 L0 9 Z" fill="currentColor"></path>
              </marker>
            </defs>
            <text x="500" y="244" font-family="IBM Plex Mono, monospace" font-size="11" letter-spacing="2" fill="currentColor">EAST</text>
          </svg>
        </div>
      </article>

      <article class="scene" aria-label="2. James River piedmont">
        <div class="scene-label">
          <span class="hud-kicker">2. James River · piedmont</span>
          <span class="hud-kicker">West ←</span>
        </div>
        <div class="scene-art">
          <svg viewBox="0 0 640 420" role="img" aria-label="Placeholder plate of the James River through the piedmont, with compass and circuit traces">
            <title>James River piedmont — placeholder</title>
            <g class="hud" transform="translate(88 78)" stroke-width="1.1">
              <circle r="22" />
              <circle r="6" />
              <path d="M0 -30 V-38 M0 30 V38 M-30 0 H-38 M30 0 H38" />
              <path d="M0 -22 L4 -8 H-4 Z" fill="currentColor" stroke="none" />
              <text x="0" y="-44" text-anchor="middle" font-size="9" font-family="IBM Plex Mono, monospace" fill="currentColor" stroke="none">N</text>
              <text x="0" y="54" text-anchor="middle" font-size="9" font-family="IBM Plex Mono, monospace" fill="currentColor" stroke="none">S</text>
              <text x="46" y="4" text-anchor="middle" font-size="9" font-family="IBM Plex Mono, monospace" fill="currentColor" stroke="none">E</text>
              <text x="-46" y="4" text-anchor="middle" font-size="9" font-family="IBM Plex Mono, monospace" fill="currentColor" stroke="none">W</text>
            </g>
            <g class="hud" stroke-width="1" opacity="0.75">
              <path d="M200 70 H250 V90 H310" />
              <path d="M310 90 H360 V70 H430 V100 H520" />
              <path d="M250 70 V48 H280" />
              <circle cx="280" cy="48" r="3" />
              <circle cx="360" cy="70" r="3" />
              <circle cx="520" cy="100" r="3" />
              <path d="M430 70 H470 V40 H510" />
              <rect x="506" y="32" width="16" height="16" />
            </g>
            <path class="ridge" d="M20 250 C90 230 140 260 210 240 C280 220 330 255 400 235 C470 215 530 250 620 230" stroke-width="1.15"></path>
            <path class="ridge" d="M20 290 C110 270 180 310 270 285 C360 260 430 305 620 270" stroke-width="1.05"></path>
            <path class="water" d="M20 318 C110 300 190 336 280 318 C370 300 460 332 620 308" fill="none" stroke-width="3.2"></path>
            <path class="ridge" d="M40 360 C160 340 280 370 420 350 C520 336 580 360 620 348" stroke-width="0.9" opacity="0.7"></path>
            <text x="220" y="312" font-family="IBM Plex Mono, monospace" font-size="10" letter-spacing="1.4" fill="currentColor">JAMES RIVER</text>
          </svg>
        </div>
      </article>

      <article class="scene" aria-label="3. Blue Ridge">
        <div class="scene-label">
          <span class="hud-kicker">3. Blue Ridge</span>
          <span class="hud-kicker">Pin</span>
        </div>
        <div class="scene-art">
          <svg viewBox="0 0 640 420" role="img" aria-label="Placeholder wireframe of the Blue Ridge with a map pin at the peak">
            <title>Blue Ridge — placeholder</title>
            <g class="ridge" stroke-width="1.15">
              <path d="M40 340 L200 210 L280 270 L360 140 L480 260 L600 200 L620 340" />
              <path d="M80 340 L200 230 L250 280 L360 170 L430 250 L560 220" opacity="0.7" />
              <path d="M140 340 C200 300 250 290 300 250 C340 220 360 180 360 140" opacity="0.55" />
              <path d="M360 140 C370 190 400 230 460 270 C510 300 560 320 620 340" opacity="0.55" />
              <path d="M220 340 C260 300 310 250 360 140 C400 230 470 300 540 340" opacity="0.4" />
            </g>
            <g class="hud" transform="translate(360 118)">
              <circle r="7" fill="none" stroke-width="1.4" />
              <circle r="2.2" fill="currentColor" />
              <path d="M0 7 L0 22" stroke-width="1.4" />
            </g>
          </svg>
        </div>
      </article>
    </div>
  </div>

  <div class="intro-bottom">
    <p class="hud-kicker">Camera flies west</p>
    <div class="progress" aria-hidden="true"><span></span></div>
    <p class="hud-kicker">~10s · then fade to menu</p>
  </div>
</div>

<script>
  const INTRO_KEY = "bc-intro-done";
  const MOTION_KEY = "bc-reduce-motion";
  const intro = document.getElementById("intro");
  const status = document.querySelector("[data-menu-status]");
  const reduceButtons = document.querySelectorAll("[data-reduce-motion]");
  const skipButtons = document.querySelectorAll("[data-skip-intro]");

  const osReduce = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const userReduce = () => localStorage.getItem(MOTION_KEY) === "1";
  const shouldReduce = () =>
    document.documentElement.dataset.reduceMotion === "true" ||
    userReduce() ||
    (localStorage.getItem(MOTION_KEY) !== "0" && osReduce());

  function setReduce(on: boolean) {
    document.documentElement.dataset.reduceMotion = on ? "true" : "false";
    localStorage.setItem(MOTION_KEY, on ? "1" : "0");
    reduceButtons.forEach((btn) => {
      btn.setAttribute("aria-pressed", on ? "true" : "false");
    });
    if (on) finishIntro(true);
  }

  function syncReduceButtons() {
    const on = shouldReduce();
    reduceButtons.forEach((btn) => {
      btn.setAttribute("aria-pressed", on ? "true" : "false");
    });
  }

  let fadeTimer = 0;
  let doneTimer = 0;

  function finishIntro(immediate = false) {
    if (!intro) return;
    window.clearTimeout(fadeTimer);
    window.clearTimeout(doneTimer);
    sessionStorage.setItem(INTRO_KEY, "1");
    if (status) status.textContent = "Animation complete";
    skipButtons.forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      if (btn.classList.contains("intro-skip")) return;
      btn.textContent = "Replay intro";
    });
    if (immediate) {
      intro.hidden = true;
      intro.classList.remove("is-playing", "is-leaving");
      intro.setAttribute("aria-hidden", "true");
      return;
    }
    intro.classList.add("is-leaving");
    doneTimer = window.setTimeout(() => {
      intro.hidden = true;
      intro.classList.remove("is-playing", "is-leaving");
      intro.setAttribute("aria-hidden", "true");
    }, 1200);
  }

  function playIntro() {
    if (!intro) return;
    sessionStorage.removeItem(INTRO_KEY);
    intro.hidden = false;
    intro.classList.remove("is-leaving");
    intro.setAttribute("aria-hidden", "false");
    intro.classList.remove("is-playing");
    void intro.offsetWidth;
    intro.classList.add("is-playing");
    if (status) status.textContent = "Flyover";
    skipButtons.forEach((btn) => {
      if (!(btn instanceof HTMLElement)) return;
      if (btn.classList.contains("intro-skip")) return;
      btn.textContent = "Skip intro";
    });
    const duration = Number(intro.dataset.duration || 10000);
    fadeTimer = window.setTimeout(() => finishIntro(false), duration);
  }

  function boot() {
    syncReduceButtons();
    const skipQuery = new URLSearchParams(window.location.search).has("skip");
    if (shouldReduce() || skipQuery || sessionStorage.getItem(INTRO_KEY) === "1") {
      finishIntro(true);
      return;
    }
    playIntro();
  }

  skipButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      if (intro && !intro.hidden) {
        finishIntro(true);
      } else if (!shouldReduce()) {
        playIntro();
      }
    });
  });

  reduceButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      setReduce(document.documentElement.dataset.reduceMotion !== "true");
    });
  });

  boot();
</script>
