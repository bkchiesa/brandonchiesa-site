---
import { existsSync } from "node:fs";
import { join } from "node:path";
import { ART, artUrl } from "../lib/art";
import { rooms, SITE_NAME, SITE_TAGLINE, withBase } from "../lib/site";

const publicDir = join(process.cwd(), "public");
const brassRel = ART.v3.mistUnderlineBrass;
const tileRel = ART.v3.mistUnderlineBrassTile;
const hasBrass = existsSync(join(publicDir, brassRel));
const hasTile = existsSync(join(publicDir, tileRel));
const brassUrl = hasBrass ? artUrl(brassRel) : hasTile ? artUrl(tileRel) : "";
---

<div class="house-ui" id="menu">
  <section class="menu menu--house" aria-labelledby="identity-name">
    <header class="house-banner identity identity--sky" data-house-banner>
      <h1 id="identity-name">[{SITE_NAME.toUpperCase()}]</h1>
      <p class="tagline">{SITE_TAGLINE}</p>
    </header>

    <nav
      class="mist-nav house-after"
      aria-label="Rooms"
      data-brass={hasBrass || hasTile ? "true" : "false"}
      style={brassUrl ? `--mist-brass-strip: url('${brassUrl}')` : undefined}
    >
      <ul class="mist-list" role="list">
        {
          rooms.map((room) => (
            <li>
              <a class="mist-label" href={withBase(room.path)} data-room={room.id}>
                <span class="mist-name">{room.name}</span>
                <span class="sr-only"> — {room.blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="menu-foot menu-foot--sky house-after">
      <button type="button" class="text-btn mono" data-skip-intro>Skip intro</button>
      <button type="button" class="text-btn mono" data-reduce-motion aria-pressed="false">
        Reduce motion
      </button>
      <p class="menu-disclaimer">
        This is a personal website. It is not affiliated with, and does not represent, First Citizens
        Bank.
      </p>
    </div>
  </section>
</div>

<script>
  const labels = Array.from(document.querySelectorAll<HTMLElement>(".mist-label"));
  labels.forEach((label) => {
    label.addEventListener("pointerdown", () => {
      labels.forEach((other) => {
        other.classList.remove("is-selected");
        other.removeAttribute("aria-current");
      });
      label.classList.add("is-selected");
      label.setAttribute("aria-current", "page");
    });
  });
</script>
