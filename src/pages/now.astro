---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Now" room="now" description="Empty field notes — a light stub for what Brandon Chiesa is noticing now.">
  <SiteHeader current="now" />
  <main id="main" class="page-main">
    <p class="hud-kicker">Room E</p>
    <h1 class="room-title">Now</h1>
    <p class="lede">A field book with the pages still blank. Notes will land here without turning the house into a feed.</p>

    <div class="notes-shell">
      <section class="frame" style="padding:1rem;" aria-labelledby="notes-index">
        <div class="filter-row">
          <label class="sr-only" for="note-filter">Filter notes</label>
          <input id="note-filter" type="search" placeholder="Filter…" disabled />
        </div>
        <h2 id="notes-index" class="hud-kicker" style="margin-top:1rem;">Note list</h2>
        <ul class="note-list">
          <li><span>Today</span><span>—</span></li>
          <li><span>Yesterday</span><span>—</span></li>
          <li><span>The ridge</span><span>—</span></li>
        </ul>
      </section>
      <article class="frame" style="padding:1.2rem;" aria-labelledby="note-empty">
        <p class="hud-kicker">Note</p>
        <h2 id="note-empty">Field notes</h2>
        <p>No entries yet. This room is a stub: a quiet desk for later dates, places, and tags.</p>
        <p class="hud-kicker" style="margin-top:1.5rem;">Tags</p>
        <p>tag one · tag two · tag three</p>
      </article>
    </div>
  </main>
  <SiteFooter />
</Base>
