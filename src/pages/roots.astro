---
import RoomHero from "../components/RoomHero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="Roots"
  room="roots"
  description="Copy stubs for a Chiesa family migration story: Valmozzola to Chicago to Virginia."
>
  <SiteHeader current="roots" />
  <main id="main" class="page-main">
    <RoomHero
      room="roots"
      alt="Family path from Valmozzola, Italy across the Atlantic to Virginia, with a radial family tree"
    />
    <p class="hud-kicker">Room D</p>
    <h1 class="room-title">Roots</h1>
    <p class="lede">
      Places that matter, and a line of people. The locked hero traces Valmozzola to Virginia; the map and tree below stay as structure until the family archive is ready.
    </p>

    <div class="roots-split">
      <section class="map-panel frame" aria-labelledby="map-title">
        <h2 id="map-title" class="hud-kicker">Migration map</h2>
        <svg viewBox="0 0 360 220" role="img" aria-label="Dotted path from Valmozzola through Chicago to Virginia">
          <title>Valmozzola to Chicago to Virginia</title>
          <ellipse cx="180" cy="110" rx="150" ry="88" fill="none" stroke="currentColor" stroke-width="1.1"></ellipse>
          <path
            d="M70 150 C120 130 150 90 200 80 C240 72 280 100 300 130"
            fill="none"
            stroke="currentColor"
            stroke-dasharray="4 4"
            stroke-width="1.2"></path>
          <g fill="currentColor">
            <circle cx="70" cy="150" r="4" />
            <circle cx="200" cy="80" r="4" />
            <circle cx="300" cy="130" r="4" />
          </g>
          <g font-family="IBM Plex Mono, monospace" font-size="9" fill="currentColor">
            <text x="78" y="168">Valmozzola</text>
            <text x="208" y="74">Chicago</text>
            <text x="250" y="148">Virginia</text>
          </g>
        </svg>
        <ol>
          <li><strong>Valmozzola</strong> — Apennine origin (Emilia-Romagna). Copy stub.</li>
          <li><strong>Chicago</strong> — first American chapter. Copy stub.</li>
          <li><strong>Virginia</strong> — James River piedmont / Blue Ridge home now. Copy stub.</li>
        </ol>
      </section>

      <section class="tree frame" aria-labelledby="tree-title">
        <h2 id="tree-title" class="hud-kicker">Family tree</h2>
        <svg class="tree-chart" viewBox="0 0 320 200" role="img" aria-label="Placeholder family tree: grandparents, parents, me">
          <title>Family connections</title>
          <g fill="none" stroke="currentColor" stroke-width="1.1">
            <rect x="110" y="12" width="100" height="32" rx="4" />
            <rect x="24" y="92" width="100" height="32" rx="4" />
            <rect x="196" y="92" width="100" height="32" rx="4" />
            <rect x="110" y="160" width="100" height="32" rx="4" />
            <path d="M160 44 V68 H74 V92 M160 68 H246 V92 M160 124 V160" />
          </g>
          <g font-family="IBM Plex Mono, monospace" font-size="9" text-anchor="middle" fill="currentColor">
            <text x="160" y="32">Grandparents</text>
            <text x="74" y="112">Parent 1</text>
            <text x="246" y="112">Parent 2</text>
            <text x="160" y="180">Me</text>
          </g>
        </svg>
        <p>Names and dates stay off this plate until the family archive is ready. Structure only.</p>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>
