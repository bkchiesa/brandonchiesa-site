---
import { existsSync } from "node:fs";
import { join } from "node:path";
import LeatherPad from "../components/LeatherPad.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import VideoShell from "../components/VideoShell.astro";
import Base from "../layouts/Base.astro";
import { ART, artUrl } from "../lib/art";
import {
  channelAnchor,
  formatPublished,
  hqThumb,
  videoSections,
} from "../lib/videography";

const publicDir = join(process.cwd(), "public");
const brassRel = ART.v3.careerBrassRule;
const hasBrass = existsSync(join(publicDir, brassRel));
const brassUrl = hasBrass ? artUrl(brassRel) : "";
const sections = videoSections();
---

<Base
  title="Videography"
  room="videography"
  videoShell
  description="Films by Brandon Chiesa — church media, family travel, and journeys — from two YouTube channels."
>
  <VideoShell />
  <LeatherPad title="Videography">
    <SiteHeader current="videography" showLetter={false} />
    <main
      id="main"
      class="page-main videography-room"
      data-brass={hasBrass ? "true" : "false"}
      style={brassUrl ? `--career-brass-rule: url('${brassUrl}')` : undefined}
    >
      <h1 class="room-title">Videography</h1>
      <p class="lede">
        Filmmaker, church media, family travel. Stills from Brandon’s public YouTube
        channels — tap a frame to watch there.
      </p>

      <nav class="video-jump" aria-label="Channels">
        {
          sections.map((section) => (
            <a class="video-jump-link" href={`#${channelAnchor(section.channel.handle)}`}>
              {section.channel.handle}
            </a>
          ))
        }
      </nav>

      {
        sections.map((section) => {
          const anchor = channelAnchor(section.channel.handle);
          const headingId = `${anchor}-title`;
          return (
            <section class="video-channel" id={anchor} aria-labelledby={headingId}>
              <p class="hud-kicker video-channel-kicker">
                {section.channel.handle}
                <span aria-hidden="true"> · </span>
                {section.videos.length} {section.videos.length === 1 ? "film" : "films"}
              </p>
              <h2 class="video-channel-title" id={headingId}>
                <a
                  href={section.channel.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {section.channel.title}
                </a>
              </h2>
              {
                section.videos.length === 0 ? (
                  <p class="video-empty">No public films on this channel yet.</p>
                ) : (
                  <ul class="video-grid">
                    {section.videos.map((video) => (
                      <li>
                        <a
                          class="video-card"
                          href={video.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <span class="video-thumb">
                            <img
                              src={video.thumb}
                              alt=""
                              width="1280"
                              height="720"
                              loading="lazy"
                              decoding="async"
                              data-video-thumb
                              data-thumb-fallback={hqThumb(video.videoId)}
                            />
                            <span class="video-thumb-miss" hidden>
                              Still unavailable
                            </span>
                          </span>
                          <h3 class="video-card-title">{video.title}</h3>
                          <p class="video-meta">
                            <span>{video.channelHandle}</span>
                            <span aria-hidden="true"> · </span>
                            <time datetime={video.published}>
                              {formatPublished(video.published)}
                            </time>
                          </p>
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </section>
          );
        })
      }
    </main>
    <SiteFooter />
  </LeatherPad>
</Base>

<script>
  document.querySelectorAll<HTMLImageElement>("[data-video-thumb]").forEach((img) => {
    const fail = () => {
      const frame = img.closest(".video-thumb");
      img.hidden = true;
      frame?.classList.add("is-miss");
      const miss = frame?.querySelector<HTMLElement>(".video-thumb-miss");
      if (miss) miss.hidden = false;
    };

    const tryFallback = () => {
      const fallback = img.getAttribute("data-thumb-fallback");
      if (fallback && img.getAttribute("src") !== fallback) {
        img.setAttribute("src", fallback);
        return;
      }
      fail();
    };

    img.addEventListener("error", tryFallback);
    img.addEventListener("load", () => {
      if (img.naturalWidth > 0 && img.naturalWidth <= 120) tryFallback();
    });

    if (img.complete) {
      if (img.naturalWidth === 0) tryFallback();
      else if (img.naturalWidth <= 120) tryFallback();
    }
  });
</script>
