---
import BankNote from "../../components/banking/BankNote.astro";
import BankingShell from "../../components/banking/BankingShell.astro";
import { calculateBreakEven, formatUsd } from "../../lib/banking/calc";
import {
  BANKING_CRUMB,
  HOME_CRUMB,
  breadcrumbJsonLd,
  calculatorJsonLd,
  graphJsonLd,
} from "../../lib/banking/seo";
import { withBase } from "../../lib/site";

const description =
  "Find the units and revenue that cover fixed costs. Optional profit target, contribution margin, and a plain-English break-even. Educational only.";
const example = {
  fixedCosts: 10_000,
  pricePerUnit: 50,
  variableCostPerUnit: 30,
  targetProfit: 5_000,
};
const initial = calculateBreakEven(example);
if (!initial.ok) throw new Error(initial.error);
const marginRatio = Math.round(initial.contributionMarginRatio * 1000) / 10;
const marginLabel = `${formatUsd(initial.contributionMargin)} · ${Number.isInteger(marginRatio) ? marginRatio.toFixed(0) : marginRatio.toFixed(1)}%`;

const jsonLd = graphJsonLd([
  calculatorJsonLd({
    name: "Break-even calculator",
    path: "/banking/break-even-calculator/",
    description,
  }),
  breadcrumbJsonLd([
    HOME_CRUMB,
    BANKING_CRUMB,
    { name: "Break-even calculator", path: "/banking/break-even-calculator/" },
  ]),
]);
---

<BankingShell title="Break-even calculator" description={description} jsonLd={jsonLd}>
  <div data-break-even>
    <p class="bank-back"><a href={withBase("banking/")}>All banking tools</a></p>
    <h1 class="room-title">Break-even calculator</h1>
    <p class="lede">How many units cover the fixed costs, and what that is in revenue. Add a profit target if you want a number past break-even.</p>

    <div class="bank-fields bank-fields--split">
      <p class="bank-field">
        <label for="be-fixed">Fixed costs</label>
        <input
          id="be-fixed"
          data-field="fixed"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          value={example.fixedCosts}
        />
      </p>
      <p class="bank-field">
        <label for="be-price">Price per unit</label>
        <input
          id="be-price"
          data-field="price"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          value={example.pricePerUnit}
        />
      </p>
      <p class="bank-field">
        <label for="be-variable">Variable cost per unit</label>
        <input
          id="be-variable"
          data-field="variable"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          value={example.variableCostPerUnit}
        />
      </p>
      <p class="bank-field">
        <label for="be-profit">Target profit (optional)</label>
        <input
          id="be-profit"
          data-field="profit"
          type="text"
          inputmode="decimal"
          autocomplete="off"
          spellcheck="false"
          value={example.targetProfit}
        />
      </p>
    </div>

    <div class="bank-results" role="status" aria-live="polite" aria-atomic="true" aria-label="Results">
      <dl class="bank-stats">
        <div>
          <dt>Break-even units</dt>
          <dd data-out="units">{initial.breakEvenUnits}</dd>
        </div>
        <div>
          <dt>Break-even revenue</dt>
          <dd data-out="revenue">{formatUsd(initial.breakEvenRevenue)}</dd>
        </div>
        <div>
          <dt>Contribution margin</dt>
          <dd data-out="margin">{marginLabel}</dd>
        </div>
      </dl>
      <p class="bank-summary" data-out="summary">{initial.summary}</p>
    </div>
    <BankNote />
  </div>
</BankingShell>

<script>
  import { bindBreakEven } from "../../scripts/banking/break-even";

  const root = document.querySelector("[data-break-even]");
  if (root instanceof HTMLElement) bindBreakEven(root);
</script>
