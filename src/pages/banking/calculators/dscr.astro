---
import DisclaimerLine from "../../../components/banking/DisclaimerLine.astro";
import BankingShell from "../../../components/banking/BankingShell.astro";
import HowTo from "../../../components/banking/HowTo.astro";
import RelatedTools from "../../../components/banking/RelatedTools.astro";
import { DSCR_DESCRIPTION, DSCR_FOLLOW_UP, DSCR_STEPS, REVIEWED_LINE } from "../../../data/banking/copy";
import { DSCR_PATH } from "../../../data/banking/tools";
import { DSCR_FOOTNOTE } from "../../../lib/banking/calc";
import { BANKING_CRUMB, HOME_CRUMB, breadcrumbJsonLd, calculatorJsonLd, graphJsonLd } from "../../../lib/banking/seo";

const title = "DSCR calculator";
const jsonLd = graphJsonLd([
  calculatorJsonLd({ name: title, path: DSCR_PATH, description: DSCR_DESCRIPTION }),
  breadcrumbJsonLd([HOME_CRUMB, BANKING_CRUMB, { name: title, path: DSCR_PATH }]),
]);
---

<BankingShell title={title} description={DSCR_DESCRIPTION} jsonLd={jsonLd} section="calculators">
  <h1 class="room-title">{title}</h1>
  <p class="lede">{DSCR_DESCRIPTION}</p>
  <div class="bank-tool" data-dscr>
    <fieldset class="bank-field">
      <legend>How do you want to enter cash flow?</legend>
      <div class="bank-segment">
        <label><input type="radio" name="dscrMode" value="parts" checked /> Build it from the parts</label>
        <label><input type="radio" name="dscrMode" value="direct" /> Enter one number</label>
      </div>
    </fieldset>
    <div data-panel="parts">
      <div class="bank-fields bank-fields--split">
        <p class="bank-field">
          <label for="dscr-ni">Net income</label>
          <input id="dscr-ni" data-field="netIncome" type="text" inputmode="decimal" value="0" autocomplete="off" />
          <span class="bank-error" data-error="netIncome"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-dep">Depreciation</label>
          <input id="dscr-dep" data-field="depreciation" type="text" inputmode="decimal" value="0" autocomplete="off" />
          <span class="bank-error" data-error="depreciation"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-amort">Amortization</label>
          <input id="dscr-amort" data-field="amortization" type="text" inputmode="decimal" value="0" autocomplete="off" />
          <span class="bank-error" data-error="amortization"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-interest">Interest</label>
          <input id="dscr-interest" data-field="interest" type="text" inputmode="decimal" value="0" autocomplete="off" />
          <span class="bank-help">Add back interest because it is already inside your loan payments. Only add back interest on debts you include in debt service.</span>
          <span class="bank-error" data-error="interest"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-once">One-time expenses</label>
          <input id="dscr-once" data-field="nonrecurring" type="text" inputmode="decimal" value="0" autocomplete="off" />
          <span class="bank-error" data-error="nonrecurring"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-excess">Excess owner compensation</label>
          <input id="dscr-excess" data-field="excess" type="text" inputmode="decimal" value="0" autocomplete="off" />
          <span class="bank-error" data-error="excess"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-draws">Owner draws</label>
          <input id="dscr-draws" data-field="draws" type="text" inputmode="decimal" value="0" autocomplete="off" />
          <span class="bank-error" data-error="draws"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-other">Other adjustment</label>
          <input id="dscr-other" data-field="other" type="text" inputmode="decimal" value="0" autocomplete="off" />
          <span class="bank-error" data-error="other"></span>
        </p>
      </div>
    </div>
    <div data-panel="direct" hidden>
      <p class="bank-field">
        <label for="dscr-cfads">Cash flow available for debt service</label>
        <input id="dscr-cfads" data-field="cashFlow" type="text" inputmode="decimal" value="0" autocomplete="off" />
        <span class="bank-error" data-error="cashFlow"></span>
      </p>
    </div>
    <div class="bank-fields">
      <p class="bank-field">
        <label for="dscr-existing">Existing annual loan payments</label>
        <input id="dscr-existing" data-field="existing" type="text" inputmode="decimal" value="0" autocomplete="off" />
        <span class="bank-help">If the new loan pays off an old one, leave the old payment out.</span>
        <span class="bank-error" data-error="existing"></span>
      </p>
      <p class="bank-field">
        <label for="dscr-proposed-mode">Proposed loan</label>
        <select id="dscr-proposed-mode" data-field="proposedMode">
          <option value="loan" selected>Use loan calculator</option>
          <option value="annual">Annual amount</option>
        </select>
      </p>
    </div>
    <div data-proposed="loan">
      <div class="bank-fields bank-fields--split">
        <p class="bank-field">
          <label for="dscr-principal">Proposed loan amount</label>
          <input id="dscr-principal" data-field="loanPrincipal" type="text" inputmode="decimal" value="250000" autocomplete="off" />
          <span class="bank-error" data-error="loanPrincipal"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-rate">Interest rate <span class="bank-example">(example only)</span></label>
          <input id="dscr-rate" data-field="loanRate" type="text" inputmode="decimal" value="7.50" autocomplete="off" />
          <span class="bank-error" data-error="loanRate"></span>
        </p>
        <p class="bank-field">
          <label for="dscr-months">Term in months</label>
          <input id="dscr-months" data-field="loanMonths" type="text" inputmode="numeric" value="120" autocomplete="off" />
          <span class="bank-error" data-error="loanMonths"></span>
        </p>
      </div>
    </div>
    <div data-proposed="annual" hidden>
      <p class="bank-field">
        <label for="dscr-annual">Proposed annual payments</label>
        <input id="dscr-annual" data-field="proposedAnnual" type="text" inputmode="decimal" value="0" autocomplete="off" />
        <span class="bank-error" data-error="proposedAnnual"></span>
      </p>
    </div>
    <div class="bank-results" data-results hidden aria-live="polite">
      <dl class="bank-stats">
        <div>
          <dt>Cash flow available</dt>
          <dd data-out="cfads"></dd>
        </div>
        <div>
          <dt>Total debt service</dt>
          <dd data-out="tds"></dd>
        </div>
        <div data-ratio-stat>
          <dt>DSCR</dt>
          <dd data-out="ratio"></dd>
        </div>
        <div>
          <dt>Cushion</dt>
          <dd data-out="cushion"></dd>
        </div>
      </dl>
      <p class="bank-summary" data-out="summary"></p>
      <details class="bank-math" id="show-the-math">
        <summary>Show the math</summary>
        <p data-out="math"></p>
      </details>
      <p class="bank-note">{DSCR_FOOTNOTE}</p>
      <p class="bank-reviewed">{REVIEWED_LINE}</p>
      <div class="bank-actions">
        <button class="bank-btn" type="button" data-print>Print results</button>
      </div>
    </div>
  </div>
  <section class="bank-block">
    <h2 class="bank-section-title">What to do with your results</h2>
    <ul class="bank-questions-list">
      {DSCR_FOLLOW_UP.map((question) => <li>{question}</li>)}
    </ul>
  </section>
  <HowTo steps={DSCR_STEPS} />
  <RelatedTools path={DSCR_PATH} />
  <DisclaimerLine />
</BankingShell>

<script>
  import { bindDscrCalculator } from "../../../scripts/banking/dscr";

  const root = document.querySelector<HTMLElement>("[data-dscr]");
  root?.querySelector("[data-print]")?.addEventListener("click", () => window.print());
  bindDscrCalculator(root);
</script>
