---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
import { BANK_DISCLAIMER } from "../lib/site";

const blocks = [
  {
    id: "education",
    title: "Education",
    body: "Hampden-Sydney College — Classical History & Political Science.",
  },
  {
    id: "career",
    title: "Career",
    body: "Truist → First Citizens Bank. VP / Business Banker, Charlottesville / Fluvanna area.",
  },
  {
    id: "community",
    title: "Community",
    body: "Fluvanna Imagination Library (Dolly Parton’s Imagination Library / DPIL) — local nonprofit literacy work.",
  },
];
---

<Base
  title="Work"
  room="work"
  description="Public bio of Brandon Chiesa: Hampden-Sydney education, banking career path, and Fluvanna Imagination Library community work."
>
  <SiteHeader current="work" />
  <main id="main" class="page-main">
    <p class="hud-kicker">Room A</p>
    <h1 class="room-title">Work</h1>
    <p class="lede">
      Three public chapters only. No banking advice, rates, products, clients, or confidential bank content.
    </p>

    <nav class="timeline" aria-label="Work chapters">
      <p class="hud-kicker">Path</p>
      <ol>
        {
          blocks.map((block, index) => (
            <li>
              <a href={`#${block.id}`}>
                <span class="mono">0{index + 1}</span>
                <span>{block.title}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <section class="card-grid three" aria-label="Public bio">
      {
        blocks.map((block) => (
          <article class="card frame" id={block.id}>
            <p class="hud-kicker">{block.title}</p>
            <h2>{block.title}</h2>
            <p>{block.body}</p>
          </article>
        ))
      }
    </section>

    <p class="disclaimer">{BANK_DISCLAIMER}</p>
  </main>
  <SiteFooter showDisclaimer />
</Base>
